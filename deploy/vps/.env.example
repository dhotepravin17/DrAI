# Copy to .env and fill in. scripts/generate-secrets.sh fills the secret values for you.
# Never commit .env.

# ---- Server ----
DOMAIN=app.example.in              # DNS A record must point to this server
ACME_EMAIL=you@example.in          # Let's Encrypt expiry notices
IMAGE_TAG=latest                   # or a pinned tag such as sha-6a9885f
SQL_MEMORY_LIMIT_MB=1536           # lower to 1024 on a 2 GB server
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=21                 # 21:00 UTC = 02:30 IST

# ---- Secrets (generate-secrets.sh) ----
SA_PASSWORD=
Jwt__SigningKey=
Push__PublicKey=
Push__PrivateKey=
Push__Subject=mailto:you@example.in

# ---- First Super Admin (10-digit mobile) ----
Bootstrap__SuperAdmins__0__MobileNumber=
Bootstrap__SuperAdmins__0__FullName=Platform Admin

# ---- Test server only (no SMS yet): show sign-in codes on screen ----
# Never use on a server real patients use: anyone could sign in with any number.
# ASPNETCORE_ENVIRONMENT=Development
# Otp__ExposeCodeInResponse=true

# ---- Security ----
Auth__AdminMfaRequired=true        # authenticator-app step for Super Admins
RateLimits__OtpPerMinutePerIp=10   # raise (e.g. 60) if many users share one network

# ---- SMS gateway (leave Sms__Provider empty until DLT registration is done) ----
Sms__Provider=
Sms__Endpoint=
Sms__ApiKey=
Sms__SenderId=
Sms__DltEntityId=
Sms__OtpTemplateId=
Sms__NotificationTemplateId=
Otp__WebOtpDomain=                 # your domain, enables one-time-code autofill

# ---- Plans and retention (optional, defaults in appsettings.json) ----
# Plans__Free__StaffAccounts=1
# Retention__NotificationLogs=180.00:00:00
