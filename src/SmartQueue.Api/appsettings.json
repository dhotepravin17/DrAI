{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "smartqueue",
    "SigningKey": ""
  },
  "Otp": {
    "Validity": "00:05:00",
    "MaxRequestsPerHour": 5,
    "MaxFailedAttempts": 5,
    "MaxAccountsPerMobile": 5,
    "ExposeCodeInResponse": false
  },
  "Auth": {
    "AdminMfaRequired": true
  },
  "RateLimits": {
    "OtpPerMinutePerIp": 10,
    "SearchPerMinutePerIp": 60
  },
  "Bootstrap": {
    "ApplyMigrationsOnStartup": false,
    "SuperAdmins": []
  },
  "Sms": {
    "Provider": null,
    "Endpoint": null,
    "SenderId": null,
    "DltEntityId": null,
    "OtpTemplateId": null,
    "NotificationTemplateId": null
  },
  "Plans": {
    "Free": { "StaffAccounts": 1, "HistoryDays": 90, "Reports": false },
    "Pro": { "StaffAccounts": 5, "HistoryDays": null, "Reports": true },
    "Premium": { "StaffAccounts": 50, "HistoryDays": null, "Reports": true }
  },
  "Retention": {
    "WorkerEnabled": true,
    "OtpAndIdempotency": "1.00:00:00",
    "NotificationLogs": "180.00:00:00",
    "AuditLogs": "1095.00:00:00",
    "ProductEvents": "1095.00:00:00"
  }
}
